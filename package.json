{
  "name": "@kurone-kito/automata",
  "version": "0.1.0",
  "private": true,
  "description": "The boilerplate project of the Node.js",
  "keywords": [
    "boilerplate",
    "pnpm",
    "template"
  ],
  "homepage": "https://github.com/kurone-kito/automata#readme",
  "bugs": "https://github.com/kurone-kito/automata/issues",
  "repository": "github:kurone-kito/automata",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "bin": "dist/bin.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "bin": "node --enable-source-maps dist/bin.mjs",
    "build": "tsc",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" dist node_modules/.cache",
    "deploy": "pnpm run postup",
    "dev": "tsc --watch",
    "down": "terraform destroy -auto-approve -compact-warnings",
    "lint": "pnpm run \"/lint:.+:check/\"",
    "lint:biome:check": "biome check",
    "lint:biome:fix": "biome check --write",
    "lint:cspell:check": "cspell lint --no-progress --show-suggestions -u \"./**/*\"",
    "lint:fix": "pnpm run \"/lint:.+:fix/\"",
    "lint:markdown:check": "markdownlint-cli2 \"**/*.md\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "postlint:fix": "pnpm run lint:cspell:check",
    "postup": "pnpm pack && pnpm run \"/postup:.+/\"",
    "postup:deploy": "multipass transfer kurone-kito-automata-*.tgz automata:/tmp/automata.tgz",
    "postup:extract": "multipass exec automata -- sudo /opt/automata/deploy",
    "prepack": "pnpm run clean && pnpm run build",
    "prepare": "pnpm dlx which -s husky && husky || true",
    "preup": "terraform init -upgrade",
    "test": "tsc --noEmit",
    "up": "terraform apply -auto-approve -compact-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@cspell/cspell-types": "^9.6.4",
    "@kurone-kito/biome-config": "^0.22.0",
    "@kurone-kito/commitlint-config": "^0.22.0",
    "@kurone-kito/cspell-config": "^0.22.0",
    "@kurone-kito/lint-staged-config": "^0.22.0",
    "@kurone-kito/markdownlint-config": "^0.22.0",
    "@kurone-kito/typescript-config": "^0.22.0-alpha.5",
    "cspell": "^9.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.20.0",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8",
  "engines": {
    "node": "^22 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
