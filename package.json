{
  "name": "@kurone-kito/automata",
  "version": "0.1.0",
  "private": true,
  "description": "An experimental project for autonomous business proposals using GitHub Copilot CLI",
  "keywords": [
    "copilot",
    "automation",
    "business"
  ],
  "homepage": "https://github.com/kurone-kito/automata#readme",
  "bugs": "https://github.com/kurone-kito/automata/issues",
  "repository": "github:kurone-kito/automata",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "bin": {
    "automata": "dist/bin.mjs",
    "ghLogin": "dist/ghLogin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bin": "node --enable-source-maps dist/bin.mjs",
    "build": "tsc",
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" dist node_modules/.cache",
    "deploy": "pnpm run --workspace-concurrency=1 \"/deploy:.+/\"",
    "deploy:0.pack": "pnpm pack --out am.tgz --pack-gzip-level=0",
    "deploy:1.transfer": "multipass transfer am.tgz automata:/tmp/am.tgz",
    "deploy:2.extract": "pnpm run multipass /opt/automata/deploy",
    "dev": "tsc --watch",
    "down": "pnpm run --workspace-concurrency=1 \"/down:.+/\"",
    "down:0.terraform": "terraform destroy -auto-approve || true",
    "down:1.multipass": "multipass delete -p automata || true",
    "lint": "pnpm run --stream \"/lint:check:.+/\"",
    "lint:check:biome": "biome check",
    "lint:check:cspell": "cspell lint --show-suggestions .",
    "lint:check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "pnpm run --stream \"/(lint:fix:.+|lint:check:cspell)/\"",
    "lint:fix:biome": "biome check --write",
    "lint:fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:fix:terraform": "terraform fmt -recursive",
    "log": "pnpm run multipass journalctl -u automata -f",
    "login:gh": "node --enable-source-maps dist/ghLogin.mjs",
    "multipass": "multipass exec automata --",
    "prepack": "pnpm run clean && pnpm run build",
    "prepare": "path-exists husky && husky || true",
    "status": "pnpm run multipass systemctl status automata",
    "test": "tsc --noEmit",
    "up": "pnpm run --workspace-concurrency=1 \"/up:.+/\"",
    "up:0.init": "terraform init -upgrade",
    "up:1.apply": "terraform apply -auto-approve",
    "up:2.deploy": "pnpm run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@cspell/cspell-types": "^9.6.4",
    "@kurone-kito/biome-config": "^0.22.0",
    "@kurone-kito/commitlint-config": "^0.22.0",
    "@kurone-kito/cspell-config": "^0.22.0",
    "@kurone-kito/lint-staged-config": "^0.22.0",
    "@kurone-kito/markdownlint-config": "^0.22.0",
    "@kurone-kito/typescript-config": "^0.22.0-alpha.6",
    "cspell": "^9.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.21.0",
    "path-exists-cli": "^2.0.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937",
  "engines": {
    "node": "^22 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
